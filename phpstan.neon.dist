includes:

parameters:

  paths:
    - src

  # The level 8 is the highest level
  level: 6

  ignoreErrors:
    - identifier: missingType.iterableValue
    - identifier: missingType.generics
    - '#Method [a-zA-Z\\\<\>]+::handle\(\) should return bool\|null but returns int.#'

  reportUnmatchedIgnoredErrors: false
